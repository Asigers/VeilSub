{
  "manifest_version": 3,
  "name": "VeilSub",
  "version": "0.1.0",
  "description": "Live subtitles for anything you watch.",
  "permissions": ["activeTab", "offscreen", "storage", "tabCapture"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "VeilSub"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
