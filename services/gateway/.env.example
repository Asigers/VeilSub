VEILSUB_ENV=development
VEILSUB_SPEECH_PROVIDER=mock
VEILSUB_TRANSLATION_PROVIDER=none

# Alibaba Cloud Model Studio / Bailian real-time ASR
DASHSCOPE_API_KEY=
ALIYUN_BAILIAN_WORKSPACE_ID=
ALIYUN_BAILIAN_REGION=cn-beijing
ALIYUN_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming

# Alibaba Cloud Machine Translation (used when translation is enabled)
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_MT_ENDPOINT=mt.cn-hangzhou.aliyuncs.com
